# ============================================================
# ProxHub — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=proxhub
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=proxhub

# --- Application ---
# Port the app will be exposed on (host side)
APP_PORT=3000

# Session cookie signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_generate_a_random_secret

# Public URL of your ProxHub instance (used in emails for links)
APP_BASE_URL=http://your-server-ip:3000

# Set to "true" if you're serving ProxHub behind HTTPS (nginx/caddy with TLS)
# Leave as "false" for plain HTTP access
COOKIE_SECURE=false

# --- SendGrid Email (optional) ---
# Required for: password reset, user invites, health digest emails
# Leave blank to disable email features
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Monitoring (optional) ---
# Health digest email interval in milliseconds (default: 1 hour)
HEALTH_DIGEST_INTERVAL_MS=3600000

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ============================================================
# Default admin credentials (created on first launch):
#   Username: admin
#   Password: admin
# IMPORTANT: Change the admin password immediately after first login!
# ============================================================
